return function(T, Loader)
	local describe, it, expect = T.describe, T.it, T.expect
	local Validate = Loader.get("ReplicatedStorage.Shared.Net.Validate")

	describe("Validate", function()
		it("checks strings: type, size and UTF-8", function()
			local v = Validate.string(5)
			expect((v("hello"))).toBe(true)
			expect((v("hello!"))).toBe(false)
			expect((v(5))).toBe(false)
			expect((v({}))).toBe(false)
			expect((v("\255"))).toBe(false)
			expect((v("žž"))).toBe(true) -- 4 bytes
		end)

		it("checks integers: finite, whole, in range", function()
			local v = Validate.integer(1, 3)
			expect((v(1))).toBe(true)
			expect((v(3))).toBe(true)
			expect((v(0))).toBe(false)
			expect((v(4))).toBe(false)
			expect((v(1.5))).toBe(false)
			expect((v(0 / 0))).toBe(false)
			expect((v(math.huge))).toBe(false)
			expect((v(-math.huge))).toBe(false)
			expect((v("1"))).toBe(false)
		end)

		it("checks numbers, booleans and enums", function()
			expect((Validate.number(0, 1)(0.5))).toBe(true)
			expect((Validate.number(0, 1)(0 / 0))).toBe(false)
			expect((Validate.boolean()(false))).toBe(true)
			expect((Validate.boolean()(nil))).toBe(false)
			expect((Validate.enum({ "a", "b" })("b"))).toBe(true)
			expect((Validate.enum({ "a", "b" })("c"))).toBe(false)
		end)

		it("requires the exact argument count, including trailing nils", function()
			local validators = { Validate.integer(1, 3), Validate.string(10) }
			expect((Validate.args(validators, 1, "x"))).toBe(true)
			expect((Validate.args(validators, 1))).toBe(false)
			expect((Validate.args(validators, 1, "x", "extra"))).toBe(false)
			expect((Validate.args(validators, 1, "x", nil))).toBe(false)
			expect((Validate.args({}))).toBe(true)
			expect((Validate.args({}, nil))).toBe(false)
		end)

		it("explains the first failing argument", function()
			local ok, reason = Validate.args({ Validate.integer(1, 3), Validate.string(10) }, 1, 5)
			expect(ok).toBe(false)
			expect(reason).toContain("argument 2")
		end)
	end)
end
